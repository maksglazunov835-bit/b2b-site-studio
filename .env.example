# Local PostgreSQL only. Copy to .env and replace placeholders before db:up.
POSTGRES_USER=replace_with_local_user
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=b2b_site_studio_local
POSTGRES_PORT=55432
DATABASE_URL=postgresql://replace_with_local_user:replace_with_local_password@127.0.0.1:55432/b2b_site_studio_local
TEST_POSTGRES_USER=replace_with_test_user
TEST_POSTGRES_PASSWORD=replace_with_test_password
TEST_POSTGRES_PORT=55433
TEST_DATABASE_URL=postgresql://replace_with_test_user:replace_with_test_password@127.0.0.1:55433/b2b_site_studio_test
