{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://b2b-site-studio.local/contracts/job.schema.json",
  "title": "B2B Site Studio Local Agent Job",
  "description": "Safe, reproducible, versioned job contract for the local Windows Codex agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobSpecVersion",
    "agentApiVersion",
    "id",
    "type",
    "projectId",
    "workspaceId",
    "repository",
    "baseRef",
    "baseCommitSha",
    "siteSpec",
    "inputArtifacts",
    "instructions",
    "constraints",
    "sandbox",
    "inputs",
    "expectedOutputManifest",
    "allowedPaths",
    "allowedCapabilities",
    "allowedActions",
    "forbiddenActions",
    "gitWorkflow",
    "approvalPolicy",
    "resultPolicy",
    "modelProfile",
    "reasoningEffort",
    "requiresApproval",
    "timeoutSeconds",
    "idempotencyKey",
    "dependsOn",
    "validationChecks"
  ],
  "properties": {
    "jobSpecVersion": { "type": "string", "pattern": "^1\\.2\\.0$" },
    "agentApiVersion": { "type": "string", "const": "v1" },
    "id": { "type": "string", "pattern": "^job_[a-z0-9][a-z0-9_\\-]{6,80}$" },
    "type": {
      "type": "string",
      "enum": [
        "sandbox_file_test",
        "design_reference_prototype",
        "site_spec_validation",
        "catalog_import_review",
        "page_plan_generation",
        "seo_review",
        "git_commit",
        "pull_request_update",
        "wordpress_publish"
      ]
    },
    "projectId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "siteId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "description": "Logical workspace key resolved by the local agent from protected local configuration. The server never sends absolute local paths."
    },
    "repository": { "$ref": "#/$defs/repositoryRef" },
    "baseRef": { "type": "string", "minLength": 1 },
    "baseCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "siteSpec": { "$ref": "#/$defs/siteSpecInputRef" },
    "inputArtifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/inputArtifactRef" }
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displaySummary", "objective", "steps", "acceptanceCriteria"],
      "properties": {
        "displaySummary": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "acceptanceCriteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "denyByDefault",
        "noRawUserTextAsShell",
        "requiresBranchOrWorktree",
        "pathFormat",
        "realpathContainment",
        "symlinkEscapePolicy",
        "maxLogBytes",
        "maxArtifactBytes"
      ],
      "properties": {
        "denyByDefault": { "type": "boolean", "const": true },
        "noRawUserTextAsShell": { "type": "boolean", "const": true },
        "requiresBranchOrWorktree": { "type": "boolean", "const": true },
        "pathFormat": { "type": "string", "const": "normalized_posix_relative_only" },
        "realpathContainment": { "type": "string", "const": "required_after_resolve" },
        "symlinkEscapePolicy": { "type": "string", "const": "reject_symlink_junction_or_reparse_escape" },
        "maxLogBytes": { "type": "integer", "minimum": 1024 },
        "maxArtifactBytes": { "type": "integer", "minimum": 1024 }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lowPrivilegeProcess",
        "networkAccess",
        "allowlistedEnvironment",
        "productionSecretsAvailable",
        "untrustedRepositoryCode",
        "resourceLimits"
      ],
      "properties": {
        "lowPrivilegeProcess": { "type": "boolean", "const": true },
        "networkAccess": { "type": "string", "enum": ["disabled_by_default", "allowlisted"] },
        "allowlistedEnvironment": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "uniqueItems": true
        },
        "productionSecretsAvailable": { "type": "boolean", "const": false },
        "untrustedRepositoryCode": {
          "type": "boolean",
          "const": true,
          "description": "Repository code, package scripts, npm lifecycle scripts, and generated files are treated as untrusted and run only inside the sandbox."
        },
        "resourceLimits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["timeoutSeconds", "cpuShares", "memoryMb", "maxFiles", "maxFileBytes"],
          "properties": {
            "timeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 14400 },
            "cpuShares": { "type": "integer", "minimum": 1 },
            "memoryMb": { "type": "integer", "minimum": 128 },
            "maxFiles": { "type": "integer", "minimum": 1 },
            "maxFileBytes": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source", "payload"],
      "properties": {
        "source": { "type": "string", "enum": ["site_spec", "user_upload", "operator_request", "system_test"] },
        "payload": {
          "description": "Structured data. This field is never executed directly as shell.",
          "type": ["object", "array", "string", "number", "boolean", "null"]
        }
      }
    },
    "expectedOutputManifest": {
      "type": "array",
      "items": { "$ref": "#/$defs/expectedOutput" },
      "minItems": 1
    },
    "allowedPaths": {
      "type": "array",
      "items": { "$ref": "#/$defs/posixRelativeGlob" },
      "minItems": 1
    },
    "allowedCapabilities": {
      "type": "array",
      "description": "Deny-by-default. A missing capability is forbidden.",
      "items": {
        "type": "string",
        "enum": [
          "codex",
          "git",
          "github_pr",
          "node",
          "file_read",
          "file_write",
          "browser_screenshot",
          "artifact_upload",
          "wordpress_api"
        ]
      },
      "uniqueItems": true
    },
    "allowedActions": {
      "type": "array",
      "description": "Deny-by-default. A missing action is forbidden even when not listed in forbiddenActions.",
      "items": {
        "type": "string",
        "enum": [
          "read_files",
          "write_files",
          "create_branch",
          "create_worktree",
          "run_registered_validation",
          "create_artifact",
          "upload_artifact",
          "request_approval",
          "git_commit",
          "git_push_feature_branch",
          "create_or_update_pull_request",
          "wordpress_stage",
          "wordpress_publish"
        ]
      },
      "uniqueItems": true
    },
    "forbiddenActions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "delete",
          "production_deploy",
          "dns_change",
          "repository_visibility",
          "credential_rotation",
          "package_install",
          "external_network_write",
          "merge_to_main",
          "push_main",
          "force_push",
          "direct_shell_from_user_text",
          "arbitrary_shell"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "gitWorkflow": { "$ref": "#/$defs/gitWorkflowPolicy" },
    "approvalPolicy": { "$ref": "#/$defs/approvalPolicy" },
    "resultPolicy": { "$ref": "#/$defs/resultPolicy" },
    "modelProfile": { "type": "string", "enum": ["fast", "standard", "deep", "review"] },
    "reasoningEffort": { "type": "string", "enum": ["minimal", "low", "medium", "high", "xhigh", "max"] },
    "requiresApproval": { "type": "boolean" },
    "timeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 14400 },
    "idempotencyKey": { "type": "string", "minLength": 12, "maxLength": 120 },
    "dependsOn": {
      "type": "array",
      "items": { "type": "string", "pattern": "^job_[a-z0-9][a-z0-9_\\-]{6,80}$" }
    },
    "validationChecks": {
      "type": "array",
      "items": { "$ref": "#/$defs/validationCheck" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "wordpress_publish" } }, "required": ["type"] },
      "then": {
        "properties": {
          "requiresApproval": { "const": true },
          "allowedActions": { "contains": { "const": "wordpress_publish" } },
          "approvalPolicy": {
            "properties": {
              "requiredForActions": { "contains": { "const": "wordpress_publish" } }
            }
          },
          "forbiddenActions": { "not": { "contains": { "const": "wordpress_publish" } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "allowedActions": { "contains": { "const": "git_push_feature_branch" } }
        },
        "required": ["allowedActions"]
      },
      "then": {
        "properties": {
          "gitWorkflow": {
            "properties": {
              "allowedPush": { "const": "feature_branch_only" },
              "forcePushAllowed": { "const": false },
              "mainPushAllowed": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "requiresApproval": { "const": true } }, "required": ["requiresApproval"] },
      "then": {
        "properties": {
          "approvalPolicy": {
            "properties": {
              "requiredForActions": { "minItems": 1 },
              "selfApprovalAllowed": { "const": false }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "repositoryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "owner", "name", "identifier", "providerRepositoryId", "originUrl"],
      "properties": {
        "provider": { "type": "string", "enum": ["github"] },
        "owner": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "identifier": {
          "type": "string",
          "description": "Stable repository identity checked before git writes.",
          "minLength": 1
        },
        "providerRepositoryId": { "type": "string", "minLength": 1 },
        "originUrl": {
          "type": "string",
          "description": "Expected git origin. Agent must verify the local checkout remote matches this value before committing or pushing.",
          "minLength": 1
        }
      }
    },
    "siteSpecInputRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "revision", "sha256", "stage"],
      "properties": {
        "schemaVersion": { "type": "string", "pattern": "^1\\.2\\.0$" },
        "revision": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "stage": { "type": "string", "enum": ["draft", "generation_ready", "publish_ready"] }
      }
    },
    "inputArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "kind", "sha256", "sizeBytes"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "expectedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "required", "contentType", "maxSizeBytes", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/posixRelativePath" },
        "kind": { "type": "string", "enum": ["file", "directory", "screenshot", "report", "diff", "manifest", "git_result", "wordpress_result"] },
        "required": { "type": "boolean" },
        "contentType": { "type": "string", "minLength": 1 },
        "maxSizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": {
          "description": "Null before creation; filled by the agent after artifact creation and verified during artifact completion.",
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "posixRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Normalized POSIX-relative concrete path. Agent must resolve and realpath-check containment after symlink/junction/reparse resolution.",
      "allOf": [
        { "not": { "pattern": "^[A-Za-z]:" } },
        { "not": { "pattern": "^/" } },
        { "not": { "pattern": "\\\\" } },
        { "not": { "pattern": ":" } },
        { "not": { "pattern": "[\\u0000-\\u001F\\u007F]" } },
        { "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
        { "not": { "pattern": "(^|/)\\.(/|$)" } },
        { "not": { "pattern": "//" } },
        { "not": { "pattern": "[*?\\[\\]{}!]" } }
      ]
    },
    "posixRelativeGlob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Normalized POSIX-relative glob. Only POSIX slash separators are accepted; realpath containment is still required for matched files.",
      "allOf": [
        { "not": { "pattern": "^[A-Za-z]:" } },
        { "not": { "pattern": "^/" } },
        { "not": { "pattern": "\\\\" } },
        { "not": { "pattern": ":" } },
        { "not": { "pattern": "[\\u0000-\\u001F\\u007F]" } },
        { "not": { "pattern": "(^|/)\\.\\.(/|$)" } },
        { "not": { "pattern": "(^|/)\\.(/|$)" } },
        { "not": { "pattern": "//" } },
        { "not": { "pattern": "[?\\[\\]{}!]" } }
      ]
    },
    "validationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "registryVersion", "required", "shellMode", "parameters", "timeoutSeconds"],
      "properties": {
        "id": { "type": "string", "enum": ["file_exists", "npm_lint", "npm_build", "git_diff_check", "static_html_exists"] },
        "registryVersion": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "shellMode": { "type": "boolean", "const": false },
        "parameters": { "type": "object" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      },
      "allOf": [
        {
          "if": { "properties": { "id": { "const": "file_exists" } }, "required": ["id"] },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "mustExist"],
                "properties": {
                  "path": { "$ref": "#/$defs/posixRelativePath" },
                  "mustExist": { "type": "boolean" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "id": { "const": "static_html_exists" } }, "required": ["id"] },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "required": ["htmlPath", "cssPath"],
                "properties": {
                  "htmlPath": { "$ref": "#/$defs/posixRelativePath" },
                  "cssPath": { "$ref": "#/$defs/posixRelativePath" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "id": { "enum": ["npm_lint", "npm_build", "git_diff_check"] } }, "required": ["id"] },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scope": { "type": "string", "enum": ["workspace"] }
                }
              }
            }
          }
        }
      ]
    },
    "gitWorkflowPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifyRepositoryIdentifier",
        "verifyRemoteOrigin",
        "baseRef",
        "baseCommitSha",
        "targetBranch",
        "branchPrefix",
        "allowedPush",
        "forcePushAllowed",
        "mainPushAllowed",
        "mergeAllowed",
        "returns"
      ],
      "properties": {
        "verifyRepositoryIdentifier": { "type": "boolean", "const": true },
        "verifyRemoteOrigin": { "type": "boolean", "const": true },
        "baseRef": { "type": "string", "minLength": 1 },
        "baseCommitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "targetBranch": { "type": ["string", "null"], "pattern": "^(?!main$)(?!master$)(?!.*\\.\\.)[A-Za-z0-9._/\\-]+$" },
        "branchPrefix": { "type": "string", "const": "codex/" },
        "allowedPush": { "type": "string", "enum": ["none", "feature_branch_only"] },
        "forcePushAllowed": { "type": "boolean", "const": false },
        "mainPushAllowed": { "type": "boolean", "const": false },
        "mergeAllowed": { "type": "boolean", "const": false },
        "returns": {
          "type": "array",
          "items": { "type": "string", "enum": ["commit_sha", "branch_name", "pull_request_url"] },
          "contains": { "const": "commit_sha" },
          "uniqueItems": true
        }
      }
    },
    "approvalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredForActions",
        "selfApprovalAllowed",
        "actorSource",
        "bodyActorFieldsTrusted",
        "requiredBindingFields",
        "bindingTemplate",
        "oneTimeDecision",
        "auditable",
        "leaseBehavior"
      ],
      "properties": {
        "requiredForActions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["production_deploy", "wordpress_publish", "dns_change", "delete", "credential_rotation", "repository_visibility"]
          },
          "uniqueItems": true
        },
        "selfApprovalAllowed": { "type": "boolean", "const": false },
        "actorSource": { "type": "string", "const": "authenticated_human_principal" },
        "bodyActorFieldsTrusted": { "type": "boolean", "const": false },
        "requiredBindingFields": {
          "type": "array",
          "const": ["jobId", "attempt", "exactAction", "exactTarget", "environment", "siteSpecSha256", "inputArtifactSha256", "previewArtifactIds", "expiresAt"]
        },
        "bindingTemplate": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["exactAction", "exactTarget", "environment", "previewArtifactIds", "expiresAt"],
              "properties": {
                "exactAction": { "type": "string", "minLength": 1 },
                "exactTarget": { "type": "string", "minLength": 1 },
                "environment": { "type": "string", "enum": ["staging", "production"] },
                "previewArtifactIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "expiresAt": { "type": "string", "format": "date-time" }
              }
            }
          ]
        },
        "oneTimeDecision": { "type": "boolean", "const": true },
        "auditable": { "type": "boolean", "const": true },
        "leaseBehavior": {
          "type": "string",
          "const": "checkpoint_release_lease_requeue_continuation_with_new_lease_or_new_irreversible_job"
        }
      }
    },
    "resultPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionResultValues",
        "acceptanceResultValues",
        "codexReportIsProof",
        "executorMayAcceptOwnWork",
        "mergeDeployPublicationRequiresAcceptance",
        "recheckAfterChangesRequired"
      ],
      "properties": {
        "executionResultValues": { "const": ["succeeded", "failed", "cancelled"] },
        "acceptanceResultValues": { "const": ["accepted", "changes_required", "blocked"] },
        "codexReportIsProof": { "type": "boolean", "const": false },
        "executorMayAcceptOwnWork": { "type": "boolean", "const": false },
        "mergeDeployPublicationRequiresAcceptance": { "type": "string", "const": "accepted" },
        "recheckAfterChangesRequired": { "type": "boolean", "const": true }
      }
    }
  },
  "examples": [
    {
      "jobSpecVersion": "1.2.0",
      "agentApiVersion": "v1",
      "id": "job_sandbox_file_test_001",
      "type": "sandbox_file_test",
      "projectId": "demo-regional-wholesale-network",
      "workspaceId": "local-demo-workspace",
      "repository": {
        "provider": "github",
        "owner": "maksglazunov835-bit",
        "name": "b2b-site-studio",
        "identifier": "github:maksglazunov835-bit/b2b-site-studio",
        "providerRepositoryId": "repo_123456789",
        "originUrl": "git@github.com:maksglazunov835-bit/b2b-site-studio.git"
      },
      "baseRef": "main",
      "baseCommitSha": "1111111111111111111111111111111111111111",
      "siteSpec": {
        "schemaVersion": "1.2.0",
        "revision": 7,
        "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "stage": "draft"
      },
      "inputArtifacts": [],
      "instructions": {
        "displaySummary": "Create one safe test file in the sandbox folder.",
        "objective": "Verify that the local agent can write an allowed artifact without touching project or production files.",
        "steps": [
          "Create sandbox/agent-smoke-test.txt.",
          "Write a short non-secret status line.",
          "Do not modify files outside the sandbox folder."
        ],
        "acceptanceCriteria": [
          "The file exists inside the allowed sandbox path.",
          "No forbidden paths are modified.",
          "Registered validation checks pass."
        ]
      },
      "constraints": {
        "denyByDefault": true,
        "noRawUserTextAsShell": true,
        "requiresBranchOrWorktree": true,
        "pathFormat": "normalized_posix_relative_only",
        "realpathContainment": "required_after_resolve",
        "symlinkEscapePolicy": "reject_symlink_junction_or_reparse_escape",
        "maxLogBytes": 65536,
        "maxArtifactBytes": 1048576
      },
      "sandbox": {
        "lowPrivilegeProcess": true,
        "networkAccess": "disabled_by_default",
        "allowlistedEnvironment": ["NODE_ENV", "PATH", "TEMP", "TMP"],
        "productionSecretsAvailable": false,
        "untrustedRepositoryCode": true,
        "resourceLimits": {
          "timeoutSeconds": 300,
          "cpuShares": 1,
          "memoryMb": 512,
          "maxFiles": 10,
          "maxFileBytes": 4096
        }
      },
      "inputs": {
        "source": "system_test",
        "payload": { "message": "Agent smoke test completed." }
      },
      "expectedOutputManifest": [
        {
          "path": "sandbox/agent-smoke-test.txt",
          "kind": "file",
          "required": true,
          "contentType": "text/plain",
          "maxSizeBytes": 4096,
          "sha256": null
        }
      ],
      "allowedPaths": ["sandbox/**"],
      "allowedCapabilities": ["codex", "git", "file_read", "file_write", "artifact_upload"],
      "allowedActions": ["create_branch", "write_files", "run_registered_validation", "create_artifact", "upload_artifact"],
      "forbiddenActions": ["delete", "production_deploy", "dns_change", "repository_visibility", "credential_rotation", "package_install", "external_network_write", "merge_to_main", "push_main", "force_push", "direct_shell_from_user_text", "arbitrary_shell"],
      "gitWorkflow": {
        "verifyRepositoryIdentifier": true,
        "verifyRemoteOrigin": true,
        "baseRef": "main",
        "baseCommitSha": "1111111111111111111111111111111111111111",
        "targetBranch": "codex/job-sandbox-file-test-001",
        "branchPrefix": "codex/",
        "allowedPush": "none",
        "forcePushAllowed": false,
        "mainPushAllowed": false,
        "mergeAllowed": false,
        "returns": ["commit_sha", "branch_name"]
      },
      "approvalPolicy": {
        "requiredForActions": [],
        "selfApprovalAllowed": false,
