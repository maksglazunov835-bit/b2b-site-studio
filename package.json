{
  "name": "b2b-site-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node server/production.mjs",
    "worker:start": "wrangler dev --config dist/server/wrangler.json",
    "db:up": "docker compose -f compose.postgres.yml up -d --wait",
    "db:down": "docker compose -f compose.postgres.yml down",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:status": "node scripts/db/status.mjs",
    "db:test:reset": "node scripts/db/test-reset.mjs",
    "contracts:runtime:generate": "node scripts/contracts/generate-site-spec-runtime-validator.mjs",
    "contracts:runtime:check": "node scripts/contracts/generate-site-spec-runtime-validator.mjs --check",
    "contracts:validate": "npm run contracts:runtime:check && node scripts/contracts/validate-contracts.mjs --schema-only",
    "test:contracts": "node scripts/contracts/validate-contracts.mjs --semantic-only",
    "test:persistence": "node --test --test-concurrency=1 tests/persistence/migrations.test.mjs tests/persistence/service.test.mjs",
    "test:persistence:http": "node scripts/persistence/http-smoke.mjs",
    "ci": "npm run contracts:validate && npm run test:contracts && npm run lint && npm run build",
    "ci:full": "npm run db:migrate && npm run db:status && npm run test:persistence && npm run ci && npm run test:persistence:http",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "pg": "8.23.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
